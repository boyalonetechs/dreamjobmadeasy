# Neon connection string. Copy .env.example to .env and fill in.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Sign auth tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

FRONTEND_URL=http://localhost:3000
PORT=8080

# Amount in kobo (minor units). 1500000 = ₦15,000.
PRICE_NGN_KOBO=1500000
PRICE_USD=19.00

# --- Payments ---
# Demo mode is opt-in and grants access WITHOUT any real payment. Never enable
# this in production. When false (default) and a provider's keys are missing,
# that provider returns 503 instead of unlocking.
PAYMENTS_DEMO_MODE=false

PAYSTACK_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
